# === Обязательные ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Отдельный API-ключ из https://console.x.ai (API Keys)
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Доступ ===
# Telegram ID через запятую (узнать: команда /myid в боте). Эти пользователи имеют доступ всегда.
# Админ может пускать людей и из Telegram: /adduser <ID>, /deluser <ID>, /users, кнопки в заявках.
# Добавленные так хранятся в DATA_DIR/users.json — на бесплатном тарифе bothost стираются при перезапуске!
ALLOWED_USER_IDS=
# Заявки на доступ: новичок видит кнопку «🙋 Запросить доступ», админам приходит заявка с кнопками
# «✅ Пустить» / «❌ Отказать». on (по умолчанию) | off
ACCESS_REQUESTS=on
# Через сколько секунд после отказа можно подать заявку снова (защита от спама)
ACCESS_REQUEST_COOLDOWN_SEC=3600

# === Модели (по умолчанию — рекомендованные в docs.x.ai на 22.10.2026) ===
XAI_CHAT_MODEL=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# === Прокси ТОЛЬКО для запросов к xAI (если xAI блокирует IP сервера) ===
# Примеры: http://user:pass@1.2.3.4:3128   socks5://user:pass@1.2.3.4:1080
XAI_PROXY=

# === Необязательно ===
# Системный промпт (если пусто — встроенный, на русском)
SYSTEM_PROMPT=
# Базовый URL API (менять обычно не нужно)
# XAI_BASE_URL=https://api.x.ai/v1
# LOG_LEVEL=INFO

# === Стоимость и баланс ===
# Админы: получают предупреждения о балансе и заявки на доступ, могут /setbalance, /adduser, /deluser, /users.
# Если пусто — админами считаются все из ALLOWED_USER_IDS.
ADMIN_USER_IDS=
# Показывать стоимость после каждого ответа (1/0)
SHOW_COST=1
# Пороги предупреждений о низком балансе, $ (каждое — один раз при пересечении)
BALANCE_WARN_THRESHOLDS=5,1

# Вариант А (точный баланс): Management API xAI.
# Ключ: console.x.ai → Settings → Management Keys (это НЕ тот же ключ, что XAI_API_KEY!).
XAI_MANAGEMENT_KEY=
# ID команды (console.x.ai). Если пусто — бот попробует определить по management key.
XAI_TEAM_ID=
# Как часто (сек.) обновлять баланс из Management API; между обновлениями бот вычитает стоимость сам
BALANCE_REFRESH_SEC=60

# Вариант Б (без Management API): стартовый остаток $ + локальный счётчик расходов.
# Исправить в любой момент командой /setbalance <сумма> (админ).
START_BALANCE_USD=
# Папка для файлов данных (balance.json — учёт баланса, users.json — добавленные пользователи). На бесплатном тарифе bothost стирается при перезапуске —
# нужен постоянный том (Basic/Pro) и путь к нему здесь.
DATA_DIR=

# Цены для ОЦЕНКИ стоимости — используются, только если xAI не вернул usage.cost_in_usd_ticks.
# По умолчанию — прайс grok-4.7 и grok-imagine-image-2.0 (docs.x.ai, 22.10.2026).
PRICE_INPUT_PER_M=2.00
PRICE_CACHED_INPUT_PER_M=0.50
PRICE_OUTPUT_PER_M=6.00
# Картинка grok-imagine-image-2.0, 1K·Low. Для 1.5K/2K бот прибавляет $0.01/$0.02, для quality=medium — ещё $0.02
# (таблица Imagine API на docs.x.ai/developers/pricing). Входная картинка (референс в /images/edits) — PRICE_IMAGE_INPUT.
PRICE_IMAGE=0.04
PRICE_IMAGE_INPUT=0.01

# === Instagram: карусели, сторис, видео ===
# Подпись бренда/аккаунта: мелко на слайдах и крупно на последнем (например @coffee.lab)
BRAND_NAME=
# Фирменный стиль — добавляется к промптам фонов и к ТЗ для Grok (палитра, настроение, «минимализм»…)
BRAND_STYLE=
# Акцентный цвет (полоска над заголовком, кнопка «Листайте», имя бренда)
BRAND_ACCENT=#FFD54A
# Разрешение фонов от xAI: 1k | 1.5k | 2k (затем обрезка/масштаб до 1080x1080 или 1080x1920)
INSTA_IMAGE_RESOLUTION=2k
# Усилие рассуждений Grok при написании текстов карусели: low | medium | high (low — быстрее и дешевле)
INSTA_REASONING_EFFORT=low
# Оценка стоимости одного запроса на тексты, $ (только для предупреждения «оценка больше баланса»)
EST_CHAT_USD=0.03
# Видео (/storyvideo): модель, разрешение 480p|720p|1080p, длительность по умолчанию (1–15 сек)
XAI_VIDEO_MODEL=grok-imagine-video-1.5-lite
VIDEO_RESOLUTION=720p
VIDEO_DURATION=6
# Цена видео за секунду для ОЦЕНКИ до старта (реальная стоимость берётся из ответа xAI).
# Пусто — по таблице docs: lite 480p $0.02, 720p $0.03, 1080p $0.14; grok-imagine-video-1.5 — $0.08/$0.14/$0.25
PRICE_VIDEO_PER_SEC=
VIDEO_TIMEOUT_SEC=600
# Сколько генераций карусели/сторис/видео выполнять одновременно (1 — бережём 256 МБ RAM)
MAX_PARALLEL_JOBS=1
# Папка для временных файлов (по умолчанию системная /tmp/grok-bot-jobs, чистится через час и при старте)
WORK_DIR=

# === Мемы (/meme, /memevideo) ===
# Звери для кнопок: ключи (cat,capybara,raccoon,shiba,quokka,otter,hamster,pygmy_hippo,penguin,macaque)
# и/или свои «Название:описание на английском». Пусто — все 10 по умолчанию.
# Пример: MEME_ANIMALS=cat,capybara,raccoon,🦊 Лиса:a fluffy red fox
MEME_ANIMALS=
# Темы мемов для кнопки «🐱 Мем» (до 12, через «;», подсказка после двоеточия). Пусто — 6 по умолчанию:
# 🧠 Психология; 💼 Работа/офис; 💰 Деньги; ❤️ Отношения; 📱 Соцсети; 🏋️ Спорт/ЗОЖ
# Пример: MEME_TOPICS=🧠 Психология; 🐶 Собачники: жизнь с собакой, прогулки в 6 утра
MEME_TOPICS=
# Разрешение картинок для мемов: 1k | 1.5k | 2k (1k экономит память, для мема хватает)
MEME_IMAGE_RESOLUTION=1k

# === Референсы (фото пользователя для /carousel, /story, /meme, /img) ===
# Режим по умолчанию, если есть референсы:
#   edit  — фото передаются в POST /v1/images/edits (до 5 шт.): стиль, персонаж, товар сохраняются;
#   style — Grok описывает стиль фото (vision), описание добавляется в промпт обычной генерации (дешевле);
#   bg    — само фото становится фоном слайда/мема, картинки не генерируются (платится только текст);
#   overlay — «Мои фото + текст»: 1 фото = 1 слайд/кадр (до REF_OVERLAY_MAX), фото без изменений,
#             Grok по фото пишет текст, бот кладёт его поверх (платится только текст).
REF_MODE=edit
# Сколько фото брать в edit/style/bg (1–5, лимит API — 5 исходных картинок на запрос)
REF_MAX=4
# Сколько фото можно для overlay (1–10); хранится max(REF_MAX, REF_OVERLAY_MAX) фото на пользователя
REF_OVERLAY_MAX=10
# overlay: где текст — bottom | top | center | auto (auto — по более «спокойной» части фото)
OVERLAY_TEXT_POS=bottom
# overlay: подложка под текстом — gradient (затемнение у края) | plate (полупрозрачная плашка)
OVERLAY_STYLE=gradient
# quality для генерации по референсам: low | medium | auto (по docs auto = medium для edits; medium дороже на $0.02)
REF_EDIT_QUALITY=low
# Описывать стиль референсов через Grok vision (≈$0.002–0.01 за раз). 0 — выключить
REF_VISION=1

# === Поиск в интернете и X (обычный чат) ===
# auto — Grok сам решает, нужен ли поиск (серверные инструменты web_search + x_search); off — без поиска.
# /search <запрос> ищет всегда, даже при off.
SEARCH_MODE=auto
# Сколько источников показывать под ответом (0 — не показывать)
SEARCH_MAX_SOURCES=5
# Какие инструменты: web,x | web | x
SEARCH_TOOLS=web,x
# Необязательно: максимум вызовов инструментов за один ответ (ограничивает расходы). Пусто — по умолчанию xAI
SEARCH_MAX_TOOL_CALLS=

# === Стиль текста и «Картинка по референсу» ===
# Спрашивать шаг «Стиль текста» в мастерах карусели/сторис/мема (по умолчанию/вручную/по референсу). 0 — не спрашивать
# (сохранённый «Мой стиль текста» всё равно применяется).
TEXT_STYLE_STEP=1
# Разрешение новых картинок кнопок «Картинка по референсу» и «Надпись на картинке → Нарисует Grok»: 1k | 2k (2k дороже)
REFIMG_RESOLUTION=1k
